---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { BUSINESS, whatsappLink } from '~/data/business';
---

<section id="zonas" class="px-4 sm:px-6 py-20 md:py-24 scroll-mt-20">
  <div class="max-w-[1200px] mx-auto bg-cv-navy text-white rounded-[32px] px-6 sm:px-10 py-14 flex flex-wrap gap-10 items-center justify-between">
    <div class="flex-[1_1_420px] flex flex-col gap-3.5">
      <h2 class="m-0 font-black text-[clamp(30px,3.6vw,44px)] leading-tight">Dónde <span class="text-cv-orange">estamos</span></h2>
      <p class="m-0 text-lg leading-relaxed text-[#D6DEF7] font-medium">
        ¿No ves tu zona? Pregúntanos: puede que ya estemos más cerca de lo que crees.
      </p>
    </div>
    <div class="flex-[1_1_360px] flex flex-wrap gap-3">
      {
        BUSINESS.areaServed.map((z) => (
          <span class="inline-flex items-center gap-2 bg-white text-cv-blue font-extrabold text-[17px] px-5 py-3.5 rounded-full">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z" />
              <circle cx="12" cy="9" r="2.5" />
            </svg>
            {z}
          </span>
        ))
      }
      <a
        href={whatsappLink('Hola, ¿llegan a mi zona? Vivo en: ')}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2.5 bg-cv-green text-white font-extrabold text-lg px-5 py-3.5 rounded-full no-underline min-h-[48px] hover:brightness-95 transition"
      >
        <WhatsAppIcon size={20} />
        Preguntar por mi zona
      </a>
    </div>
  </div>
</section>
