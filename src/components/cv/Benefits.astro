---
import Isotipo from './Isotipo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappLink } from '~/data/business';
---

<section class="px-4 sm:px-6 pb-20 md:pb-24">
  <div class="max-w-[1200px] mx-auto flex flex-col gap-8">
    <h2 class="m-0 font-black text-[clamp(32px,4vw,48px)] leading-[1.08] text-cv-blue max-w-[720px]">
      Lo que te llevas con Cosmovision
    </h2>
    <div class="flex flex-wrap gap-5">
      <div class="flex-[2_1_520px] min-h-[300px] bg-cv-blue text-white rounded-[28px] p-9 flex flex-col justify-between gap-6">
        <Isotipo class="w-[84px] h-[84px]" />
        <div class="flex flex-col gap-2.5">
          <h3 class="m-0 font-black text-[clamp(28px,3vw,36px)] leading-tight">Fibra óptica hasta tu casa</h3>
          <p class="m-0 text-lg leading-relaxed text-[#D6DEF7] font-medium max-w-[460px]">
            Nada de cobre ni señal compartida a medias: la fibra llega directo a tu router.
          </p>
        </div>
      </div>
      <div class="flex-[1_1_260px] min-h-[300px] bg-cv-orange text-cv-navy rounded-[28px] p-9 flex flex-col justify-between gap-6">
        <span class="font-black text-[80px] leading-[0.9]">0</span>
        <div class="flex flex-col gap-2">
          <h3 class="m-0 font-black text-[26px]">Contratos</h3>
          <p class="m-0 text-base leading-relaxed font-semibold">Si un día te vas, nos ponemos tristes. Pero no te cobramos.</p>
        </div>
      </div>
      <div class="flex-[1_1_260px] min-h-[240px] bg-white border border-cv-line rounded-[28px] p-8 flex flex-col justify-between gap-5">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0028CE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
        <div class="flex flex-col gap-1.5">
          <h3 class="m-0 font-extrabold text-2xl text-cv-blue">Instalación gratis</h3>
          <p class="m-0 text-[15px] leading-relaxed text-cv-text font-medium">Nuestros técnicos llegan, instalan y te dejan navegando.</p>
        </div>
      </div>
      <div class="flex-[1_1_260px] min-h-[240px] bg-white border border-cv-line rounded-[28px] p-8 flex flex-col justify-between gap-5">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0028CE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="13" rx="2"></rect><path d="M17 2l-5 5-5-5"></path></svg>
        <div class="flex flex-col gap-1.5">
          <h3 class="m-0 font-extrabold text-2xl text-cv-blue">+90 canales</h3>
          <p class="m-0 text-[15px] leading-relaxed text-cv-text font-medium">Hasta 3 televisores incluidos en los planes Internet + TV.</p>
        </div>
      </div>
      <div class="flex-[1_1_260px] min-h-[240px] bg-cv-sky rounded-[28px] p-8 flex flex-col justify-between gap-5">
        <span class="font-black text-[56px] leading-[0.9] text-cv-blue">15</span>
        <div class="flex flex-col gap-1.5">
          <h3 class="m-0 font-extrabold text-2xl text-cv-blue">Años de experiencia</h3>
          <p class="m-0 text-[15px] leading-relaxed text-cv-text font-medium">Una empresa guatemalteca que conoce tu zona.</p>
        </div>
      </div>
      <div class="flex-[2_1_520px] min-h-[240px] bg-white border border-cv-line rounded-[28px] p-8 flex flex-wrap items-center justify-between gap-6">
        <div class="flex-[1_1_280px] flex flex-col gap-2">
          <h3 class="m-0 font-extrabold text-[28px] text-cv-blue">Soporte de gente de aquí</h3>
          <p class="m-0 text-base leading-relaxed text-cv-text font-medium">
            ¿Algo falla? Escríbenos por WhatsApp o llama al PBX 2376-4646. Sin robots, sin menús eternos.
          </p>
        </div>
        <a
          href={whatsappLink('Hola, necesito ayuda con mi servicio de Cosmovision.')}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2.5 bg-cv-green text-white no-underline font-extrabold text-lg px-5 py-3.5 rounded-full min-h-[48px] hover:brightness-95 transition"
        >
          <WhatsAppIcon size={20} />
          Escríbenos por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
