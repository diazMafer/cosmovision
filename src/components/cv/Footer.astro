---
import { Image } from 'astro:assets';
import logoBlanco from '~/assets/images/logoN.png';
import { footerData } from '~/navigation';
---

<footer class="bg-cv-navy text-[#C9D3F0] px-4 sm:px-6 pt-16 pb-10">
  <div class="max-w-[1200px] mx-auto flex flex-col gap-10">
    <div class="flex flex-wrap justify-between gap-10">
      <div class="flex-[1_1_280px] flex flex-col gap-4">
        <Image src={logoBlanco} alt="Cosmovision" width={190} height={52} class="h-9 w-auto self-start" />
        <p class="m-0 text-[15px] leading-relaxed font-medium max-w-xs">
          Internet por fibra óptica y TV por cable en Villa Nueva, Ciudad Peronia y Sacatepéquez. 15 años conectando
          Guatemala.
        </p>
      </div>
      {
        footerData.links.map((group) => (
          <div class="flex-[1_1_180px] flex flex-col gap-2.5 text-[15px] font-medium">
            <span class="font-extrabold text-white">{group.title}</span>
            {group.links.map((l) =>
              l.href ? (
                <a
                  href={l.href}
                  target={l.target}
                  rel={l.target === '_blank' ? 'noopener' : undefined}
                  class="text-[#C9D3F0] hover:text-white transition"
                >
                  {l.text}
                </a>
              ) : (
                <span>{l.text}</span>
              )
            )}
          </div>
        ))
      }
    </div>
    <div class="border-t border-[#1E2C5E] pt-6 flex flex-wrap justify-between gap-4 text-[13px] text-[#A9B5DB] font-medium">
      <span>© {new Date().getFullYear()} Cosmovision. Todos los derechos reservados.</span>
      {
        footerData.socialLinks.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" class="text-[#A9B5DB] hover:text-white">
            {s.ariaLabel}
          </a>
        ))
      }
    </div>
  </div>
</footer>
