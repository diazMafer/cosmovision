---
// Google Analytics 4 directo (gtag.js) + evento de clic en WhatsApp.
// Cada clic a wa.me envía el evento "whatsapp_click" con el texto del botón,
// el plan elegido (si aplica) y la página, para medir qué planes generan más interés.
import { BUSINESS } from '~/data/business';

const id = BUSINESS.googleAnalyticsId;
---

{
  id && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', id);

        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[href*="wa.me/"]') : null;
          if (!a) return;
          var text = '';
          try {
            text = decodeURIComponent((a.href.split('text=')[1] || '').replace(/\+/g, ' '));
          } catch (err) {}
          var plan = (text.match(/Plan [^.]+?(?= ?\.|$)/) || [''])[0];
          gtag('event', 'whatsapp_click', {
            boton: (a.innerText || a.getAttribute('aria-label') || '').trim().slice(0, 80),
            plan: plan || '(sin plan)',
            pagina: location.pathname,
            transport_type: 'beacon',
          });
        });
      </script>
    </>
  )
}
