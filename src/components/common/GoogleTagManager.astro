---
// Google Tag Manager + eventos de clic en WhatsApp.
// Cada clic a wa.me envía al dataLayer el evento "whatsapp_click" con el texto del botón,
// la página y, si aplica, el plan elegido (para medir qué planes generan más interés).
import { BUSINESS } from '~/data/business';

export interface Props {
  noscript?: boolean;
}

const { noscript = false } = Astro.props;
const id = BUSINESS.googleTagManagerId;
---

{
  id && noscript && (
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${id}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      />
    </noscript>
  )
}

{
  id && !noscript && (
    <>
      <script is:inline define:vars={{ id }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', id);
      </script>
      <script is:inline>
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[href*="wa.me/"]') : null;
          if (!a) return;
          var text = '';
          try {
            text = decodeURIComponent((a.href.split('text=')[1] || '').replace(/\+/g, ' '));
          } catch (err) {}
          var plan = (text.match(/Plan [^.]+?(?= ?\.|$)/) || [''])[0];
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'whatsapp_click',
            boton: (a.innerText || a.getAttribute('aria-label') || '').trim().slice(0, 80),
            plan: plan,
            pagina: location.pathname,
          });
        });
      </script>
    </>
  )
}
