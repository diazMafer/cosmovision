---
import { Icon } from 'astro-icon/components';
import { whatsappLink } from '~/data/business';

const href = whatsappLink('Hola, quiero más información sobre los servicios de Cosmovision');
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
  class="fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-full bg-[#1FA855] px-4 py-3 text-white shadow-lg transition hover:scale-105 hover:shadow-xl focus:outline-none focus-visible:ring-4 focus-visible:ring-green-300"
>
  <Icon name="tabler:brand-whatsapp" class="w-7 h-7" />
  <span class="hidden sm:inline font-bold text-lg">¿Te ayudamos?</span>
</a>
