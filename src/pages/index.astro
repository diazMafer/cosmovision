---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/cv/Hero.astro';
import TrustStrip from '~/components/cv/TrustStrip.astro';
import Plans from '~/components/cv/Plans.astro';
import Benefits from '~/components/cv/Benefits.astro';
import Steps from '~/components/cv/Steps.astro';
import Zones from '~/components/cv/Zones.astro';
import Faq from '~/components/cv/Faq.astro';
import CtaBand from '~/components/cv/CtaBand.astro';

const metadata = {
  title: 'Cosmovision — Internet por fibra óptica y Cable TV en Guatemala',
  ignoreTitleTemplate: true,
  description:
    'Internet por fibra óptica y cable TV para tu hogar o negocio en Villa Nueva, Ciudad Peronia y Sacatepéquez. Desde Q180 al mes, sin contrato y con instalación gratis.',
};
---

<Layout metadata={metadata}>
  <Hero />
  <TrustStrip />
  <Plans />
  <Benefits />
  <Steps />
  <Zones />
  <Faq limit={4} showMoreLink />
  <CtaBand />
</Layout>
