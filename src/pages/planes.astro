---
import Layout from '~/layouts/PageLayout.astro';
import Plans from '~/components/cv/Plans.astro';
import Steps from '~/components/cv/Steps.astro';
import Faq from '~/components/cv/Faq.astro';
import CtaBand from '~/components/cv/CtaBand.astro';
import { faqSchema } from '~/data/plans';

const metadata = {
  title: 'Planes de Internet y TV por fibra óptica en Guatemala',
  description:
    'Planes de internet por fibra óptica desde Q180 al mes y paquetes Internet + TV desde Q199. Sin contrato y sin costo de instalación en Villa Nueva, Ciudad Peronia y Sacatepéquez.',
};
---

<Layout metadata={metadata} structuredData={[faqSchema]}>
  <div class="bg-white">
    <Plans
      headingLevel="h1"
      title="Planes de internet por fibra óptica"
      subtitle="Elige solo internet o internet + TV con más de 90 canales. Precio fijo, instalación gratis y sin contrato."
    />
  </div>
  <Steps />
  <Faq />
  <CtaBand />
</Layout>
